# Copy to .env for local work. Never commit the real file.
# On Vercel these are set in Project Settings -> Environment Variables.

# Postgres. Use the POOLED connection string (contains "-pooler"): serverless
# opens a connection per invocation and unpooled Postgres runs out of
# connections long before it runs out of traffic.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The same database WITHOUT "-pooler". Migrations cannot run through a pooler.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. 32+ chars, random, secret.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Which timezone decides what "today" means. Required in production, because
# the host clock is UTC and an evening deposit would land on tomorrow's date.
BUSINESS_TZ="America/Vancouver"

# Company Admin PIN. Read once by the seed and stored only as a hash.
# Leave unset and the seed generates one and prints it.
ADMIN_PIN=""
