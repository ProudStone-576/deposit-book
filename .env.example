# Copy to .env and fill in. Never commit the real file.

# SQLite file. Use an ABSOLUTE path: in production the server's working
# directory is inside .next/, so a relative path points somewhere unintended.
# In Docker this is the mounted volume.
DATABASE_URL="file:/data/deposits.db"

# Signs the session cookie. 32+ chars, random, secret.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Which timezone decides what "today" means. Required in production.
BUSINESS_TZ="America/Vancouver"

# Company Admin PIN, read once by the seed and stored only as a hash.
# Leave unset and the seed generates one and prints it.
ADMIN_PIN=""

# Backups. The app backs itself up on this interval; no cron needed.
BACKUP_DIR="/data/backups"
BACKUP_KEEP="30"
BACKUP_INTERVAL_HOURS="6"
# A second copy somewhere that is NOT this disk: a mounted share, a synced
# folder, another volume. A backup beside the original does not survive the
# failure that destroys the original. Absolute path.
#   Windows + OneDrive:  C:/Users/<you>/OneDrive/DepositBook-Backups
#   Linux + rclone:      /mnt/backup-mirror
BACKUP_MIRROR_DIR=""
